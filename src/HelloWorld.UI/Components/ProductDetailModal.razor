@using HelloWorld.Application.Features.Results.ProductResults
@rendermode InteractiveServer
@if (IsOpen)
{
<div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">@Product?.ProductName</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (Product is null)
                    {
                        <p>Loading...</p>
                    }
                    else
                    {
                        <p>Fiyat: @Product.Price ₺</p>
                        <p>Stok: @Product.InStock</p>
                        <p>Açıklama: @Product.Description</p>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">
                        Kapat
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public GetProductsQueryResult? Product { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<GetProductsQueryResult> OnAddToCart { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task AddToCart()
    {
        if (Product is not null)
            await OnAddToCart.InvokeAsync(Product);
    }
    public async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }
}
