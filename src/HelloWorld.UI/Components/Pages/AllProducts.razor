@page "/allproducts"
@using HelloWorld.Application.Features.Results.ProductResults
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer

@if (Products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var product in Products)
        {
            <ProductCard Product="product"
                         OnAddToCart="AddToCart"
                         OnDetail="OpenDetailModal" />
        }
    </div>

    <ProductDetailModal Product="SelectedProduct"
                        IsOpen="IsModalOpen"
                        OnClose="CloseDetailModal" />

}


@code {
    private List<GetProductsQueryResult>? Products { get; set; }

    public GetProductsQueryResult? SelectedProduct;
    public bool IsModalOpen { get; set; }

    public void OpenDetailModal(string Id)
    {
        IsModalOpen = true;
        SelectedProduct = Products?.FirstOrDefault(x => x.Id == Id);
        StateHasChanged();
    }

    public void CloseDetailModal()
    {
        IsModalOpen = false;
    }


    public void AddToCart(GetProductsQueryResult product)
    {
        Console.WriteLine($"{product.ProductName} sepete eklendi");
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("asdasd");
        Products = await Http.GetFromJsonAsync<List<GetProductsQueryResult>>(
            "http://localhost:5282/api/Products"
        );
    }
}
