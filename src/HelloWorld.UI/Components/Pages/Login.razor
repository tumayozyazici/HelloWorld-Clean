@page "/login"
@using HelloWorld.UI.Dtos.AuthDtos
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg" style="width: 400px;">
        <div class="card-body p-4">

            <h3 class="text-center mb-4">Giriş Yap</h3>

            <div class="mb-3">
                <label class="form-label">E-posta</label>
                <input type="email" class="form-control" placeholder="email@example.com" @bind="LoginDto.UsernameOrEmail">
                
            </div>

            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password" class="form-control" placeholder="********" @bind="LoginDto.Password">
            </div>

            @* <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Beni hatırla
                    </label>
                </div>
                <a href="#" class="text-decoration-none">Şifremi unuttum</a>
            </div> *@

            <button class="btn btn-primary w-100" @onclick="OnLogin">Giriş Yap</button>

            <div class="text-center mt-3">
                <small>Hesabın yok mu? <a href="/register" class="text-decoration-none">Kayıt Ol</a></small>
            </div>

        </div>
    </div>
</div>

@code {

    private LoginDto LoginDto { get; set; } = new();   
    private string? errorMessage="";
    
    private async Task OnLogin(){
        var response = await Http.PostAsJsonAsync<LoginDto>("http://localhost:5282/api/Logins", LoginDto);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Giriş başarısız. Lütfen bilgilerinizi kontrol edin.";
            return;
        }

        // Token'ı localStorage'a kaydet
        Navigation.NavigateTo("/");
    }
}