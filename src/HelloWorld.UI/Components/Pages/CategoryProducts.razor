@page "/categoryproducts/{CategoryId}"
@using HelloWorld.Application.Features.Results.ProductResults
@inject HttpClient Http
@rendermode InteractiveServer

<h3>Seçilen kategorinin ürünleri</h3>

@if (Products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var product in Products)
        {
            <ProductCard Product="product"
                         OnAddToCart="AddToCart"
                         OnDetail="OpenDetailModal" />
        }
    </div>
    <ProductDetailModal Product="SelectedProduct"
                        IsOpen="IsModalOpen"
                        OnClose="CloseDetailModal"
                        OnAddToCart="AddToCart" />
}

@code {
    [Parameter]
    public string CategoryId { get; set; }

    public List<GetProductsQueryResult> Products { get; set; }

    GetProductsQueryResult? SelectedProduct;
    public bool IsModalOpen { get; set; }

    public void OpenDetailModal(string Id)
    {
        IsModalOpen = true;
        SelectedProduct = Products?.FirstOrDefault(x => x.Id == Id);
        StateHasChanged();
    }

    public void CloseDetailModal()
    {
        IsModalOpen = false;
    }

    void AddToCart(GetProductsQueryResult product)
    {
        // Basket logic
        Console.WriteLine($"{product.ProductName} sepete eklendi");
    }

    protected override async Task OnInitializedAsync()
    {
        Products = await Http.GetFromJsonAsync<List<GetProductsQueryResult>>($"http://localhost:5282/api/Products/GetProductsByCategoryId/{CategoryId}");
    }
}
