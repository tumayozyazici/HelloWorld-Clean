@page "/categoryproducts/{CategoryId}"
@using HelloWorld.Application.Features.Results.ProductResults
@inject HttpClient Http

<h3>Seçilen kategorinin ürünleri</h3>

@if (Products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var product in Products)
        {
            <div class="card m-2" style="width: 18rem;">
                <img src="/visuals/blank.jpg" class="card-img-top" />
                <div class="card-body">
                    <h5 class="card-title">@product.ProductName</h5>
                    <p class="card-text">Ücreti: @product.Price</p>
                    <p class="card-text">Stok: @product.InStock</p>
                    <div class="d-flex flex-wrap gap-4">
                        <a href="" class="btn btn-secondary">Ürün Detayı</a>
                        <a href="" class="btn btn-primary">Sepete Ekle</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string CategoryId { get; set; }

    public List<GetProductsByCategoryIdQueryResult> Products { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Products = await Http.GetFromJsonAsync<List<GetProductsByCategoryIdQueryResult>>($"http://localhost:5282/api/Products/GetProductsByCategoryId/{CategoryId}");
    }
}
